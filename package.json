  "private": true,
  "description": "Verity — an educational, explainable loan-decision simulation (CSIT305 academic project). Not a real lending system.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
