# Copy this file to `.env` and adjust if needed.
#
# SQLite database file used by Prisma. The path is relative to prisma/schema.prisma,
# so this creates prisma/dev.db. Never commit the .db file.
DATABASE_URL="file:./dev.db"

# Future PostgreSQL example (see README → "Migrating to PostgreSQL"):
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/verity?schema=public"

# Optional: path to the project dataset CSV used by "Load from the project dataset".
# Defaults to data/synthetic_personal_finance_dataset.csv
# DATASET_PATH="data/synthetic_personal_finance_dataset.csv"
